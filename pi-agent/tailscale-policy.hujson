// Proposed Tailnet policy. Paste in https://login.tailscale.com/admin/acls/file
// Changes vs. the default allow-all policy:
//   1. tag:pi-agent exists and only tailnet admins may apply it.
//   2. The allow-all rule's src goes from "*" to "autogroup:member" so a tagged
//      Sandbox has NO outbound access to the rest of the Tailnet. You (a member)
//      keep full access to everything, including the Sandbox.
//   3. Tailscale SSH into the Sandbox as user "pi", re-authentication required.
{
    "tagOwners": {
        "tag:pi-agent": ["autogroup:admin"],
    },

    "acls": [
        {
            "action": "accept",
            "src":    ["autogroup:member"],
            "dst":    ["*:*"],
        },
    ],

    "ssh": [
        // Existing rule, unchanged.
        {
            "action": "check",
            "src":    ["autogroup:member"],
            "dst":    ["autogroup:self"],
            "users":  ["autogroup:nonroot", "root"],
        },
        // New: SSH into the Sandbox as the unprivileged "pi" user only.
        {
            "action": "check",
            "src":    ["autogroup:member"],
            "dst":    ["tag:pi-agent"],
            "users":  ["pi"],
        },
    ],
}
